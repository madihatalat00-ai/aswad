# --- Meta WhatsApp Cloud API (developers.facebook.com) ---
# Permanent access token from your Meta app (System User token recommended)
WHATSAPP_TOKEN=
# "Phone number ID" shown under WhatsApp > API Setup (not the phone number itself)
PHONE_NUMBER_ID=
# Any secret string you choose; enter the same value when configuring the webhook in Meta
VERIFY_TOKEN=

# Approved message template used for the first message
TEMPLATE_NAME=feedback_request
TEMPLATE_LANGUAGE=en_US

# --- Feed sources ---
# Secret set on the WooCommerce webhook (WooCommerce > Settings > Advanced > Webhooks)
WC_WEBHOOK_SECRET=
# Order status that triggers a feedback request
WC_TRIGGER_STATUS=completed
# Token protecting /api/orders, /admin and CSV export — choose a long random string
ADMIN_TOKEN=

# --- Behaviour ---
# How long after the order completes before the feedback message is sent
FEEDBACK_DELAY_HOURS=24
# Country code assumed for 10-digit phone numbers
DEFAULT_COUNTRY_CODE=91
# Optional thank-you coupon code sent after feedback is given
DISCOUNT_CODE=
BRAND_NAME=Ru Posh

PORT=3000
DB_PATH=feedback.db
